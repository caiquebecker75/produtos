rules_version = '2';
// Instalações 75 LAB
// - Cada página de produto tem uma senha, definida pela equipe no painel (senhas/{projeto}).
// - A página só abre com a senha: o navegador pede portas/{projeto}/chaves/{hash} e a regra compara o hash.
// - Com a senha certa, quem escaneia o QR CRIA um registro de instalação.
// - Só a equipe 75 LAB (login Google @75lab.com.br) lê registros e lê/troca senhas.
service cloud.firestore {
  match /databases/{database}/documents {

    function equipe75() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@75lab[.]com[.]br$');
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function slugValido(s) {
      return s is string && s.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && s.size() <= 80;
    }

    function senhaConfere(projeto, hash) {
      return exists(/databases/$(database)/documents/senhas/$(projeto))
        && get(/databases/$(database)/documents/senhas/$(projeto)).data.hash == hash;
    }

    function geoValida(g) {
      return g == null || (g is map
        && g.keys().hasOnly(['lat', 'lng', 'precisao'])
        && g.lat is number && g.lat >= -90 && g.lat <= 90
        && g.lng is number && g.lng >= -180 && g.lng <= 180
        && (!('precisao' in g) || g.precisao is number));
    }

    match /senhas/{projeto} {
      allow read, delete: if equipe75();
      allow create, update: if equipe75()
        && slugValido(projeto)
        && request.resource.data.keys().hasOnly(['senha', 'hash', 'atualizadoEm', 'atualizadoPor'])
        && texto(request.resource.data.senha, 4, 40)
        && request.resource.data.hash is string && request.resource.data.hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == request.auth.token.email;
    }

    // "porta" da página: ler este caminho só é permitido com o hash da senha certa (o documento nem existe)
    match /portas/{projeto}/chaves/{hash} {
      allow get: if slugValido(projeto) && senhaConfere(projeto, hash);
    }

    match /instalacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'projeto', 'projetoNome', 'cliente', 'nome', 'telefone', 'loja',
            'geo', 'geoStatus', 'origem', 'aparelho', 'senhaHash', 'criadoEm'])
        && slugValido(request.resource.data.projeto)
        && texto(request.resource.data.projetoNome, 0, 140)
        && texto(request.resource.data.cliente, 0, 100)
        && texto(request.resource.data.nome, 2, 80)
        && texto(request.resource.data.telefone, 8, 20)
        && texto(request.resource.data.loja, 2, 140)
        && geoValida(request.resource.data.geo)
        && texto(request.resource.data.geoStatus, 0, 20)
        && texto(request.resource.data.origem, 0, 10)
        && texto(request.resource.data.aparelho, 0, 200)
        && request.resource.data.criadoEm == request.time
        && senhaConfere(request.resource.data.projeto, request.resource.data.senhaHash);

      allow read, update, delete: if equipe75();
    }

    match /{doc=**} {
      allow read, write: if false;
    }
  }
}
