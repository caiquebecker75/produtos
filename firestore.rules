rules_version = '2';
// Instalações 75 LAB
// - Cada página de produto tem uma senha, definida pela equipe no painel (senhas/{projeto}).
// - A página só abre com a senha: o navegador pede portas/{projeto}/chaves/{hash} e a regra compara o hash.
// - Com a senha certa, quem escaneia o QR CRIA um registro de instalação.
// - Só a equipe 75 LAB (login Google @75lab.com.br) lê registros e lê/troca senhas.
service cloud.firestore {
  match /databases/{database}/documents {

    function equipe75() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@75lab[.]com[.]br$');
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function slugValido(s) {
      return s is string && s.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && s.size() <= 80;
    }

    function senhaConfere(projeto, hash) {
      return exists(/databases/$(database)/documents/senhas/$(projeto))
        && get(/databases/$(database)/documents/senhas/$(projeto)).data.hash == hash;
    }

    // página tirada do ar no painel (paginas/{projeto}.ativo == false); sem documento = no ar
    function paginaNoAr(projeto) {
      return !exists(/databases/$(database)/documents/paginas/$(projeto))
        || get(/databases/$(database)/documents/paginas/$(projeto)).data.get('ativo', true) != false; // documento só com semSenha não tem ativo
    }

    function geoValida(g) {
      return g == null || (g is map
        && g.keys().hasOnly(['lat', 'lng', 'precisao'])
        && g.lat is number && g.lat >= -90 && g.lat <= 90
        && g.lng is number && g.lng >= -180 && g.lng <= 180
        && (!('precisao' in g) || g.precisao is number));
    }

    function projetoPublico(slug) {
      return exists(/databases/$(database)/documents/publicos/$(slug))
        && (get(/databases/$(database)/documents/publicos/$(slug)).data.get('ate', null) == null
            || get(/databases/$(database)/documents/publicos/$(slug)).data.ate > request.time);
    }

    function projetoComFotoPublica(slug) {
      return projetoPublico(slug)
        && get(/databases/$(database)/documents/publicos/$(slug)).data.get('fotos', false) == true;
    }

    match /senhas/{projeto} {
      allow read, delete: if equipe75();
      allow create, update: if equipe75()
        && slugValido(projeto)
        && request.resource.data.keys().hasOnly(['senha', 'hash', 'atualizadoEm', 'atualizadoPor'])
        && texto(request.resource.data.senha, 4, 40)
        && request.resource.data.hash is string && request.resource.data.hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == request.auth.token.email;
    }

    // acesso livre ligado no painel (paginas/{projeto}.semSenha == true): abre e registra sem senha
    function paginaSemSenha(projeto) {
      return exists(/databases/$(database)/documents/paginas/$(projeto))
        && get(/databases/$(database)/documents/paginas/$(projeto)).data.get('semSenha', false) == true;
    }

    // cada botão do painel grava só a sua parte (merge): no ar/fora do ar em ativo + atualizadoEm/Por,
    // acesso livre em semSenha + semSenhaEm/Por. Quem mudou um campo precisa carimbar data e e-mail dele.
    function paginaValida(projeto) {
      let d = request.resource.data;
      let mudou = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return equipe75()
        && slugValido(projeto)
        && d.keys().hasOnly(['ativo', 'atualizadoEm', 'atualizadoPor', 'semSenha', 'semSenhaEm', 'semSenhaPor', 'pecasOff', 'pecasOffEm', 'pecasOffPor'])
        && (!('ativo' in d) || d.ativo is bool)
        && (!('semSenha' in d) || d.semSenha is bool)
        && (!('pecasOff' in d) || (d.pecasOff is list && d.pecasOff.size() <= 20))
        && (!mudou.hasAny(['ativo']) || (d.atualizadoEm == request.time && d.atualizadoPor == request.auth.token.email))
        && (!mudou.hasAny(['semSenha']) || (d.semSenhaEm == request.time && d.semSenhaPor == request.auth.token.email))
        && (!mudou.hasAny(['pecasOff']) || (d.pecasOffEm == request.time && d.pecasOffPor == request.auth.token.email));
    }

    // enxoval: peças desabilitadas no painel (paginas/{projeto}.pecasOff) não entram em registro novo
    function temPecaDesligada(projeto, pecas) {
      return exists(/databases/$(database)/documents/paginas/$(projeto))
        && get(/databases/$(database)/documents/paginas/$(projeto)).data.get('pecasOff', []).hasAny(pecas);
    }

    // no ar / fora do ar e acesso livre: qualquer um consulta uma página (a própria página precisa saber); só a equipe lista e muda
    match /paginas/{projeto} {
      allow get: if true;
      allow list, delete: if equipe75();
      allow create, update: if paginaValida(projeto);
    }

    // "porta" da página: ler este caminho só é permitido com o hash da senha certa (o documento nem existe)
    match /portas/{projeto}/chaves/{hash} {
      allow get: if slugValido(projeto) && paginaNoAr(projeto)
        && (senhaConfere(projeto, hash) || paginaSemSenha(projeto));
    }

    match /instalacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'projeto', 'projetoNome', 'cliente', 'nome', 'telefone', 'loja',
            'bandeira', 'tipoPromotor', 'temFoto',
            'geo', 'geoStatus', 'origem', 'aparelho', 'senhaHash', 'pecas', 'criadoEm'])
        // rede e tipo de promotor (16/09): opcionais para aparelhos com a página antiga em cache
        && (!('bandeira' in request.resource.data) || texto(request.resource.data.bandeira, 2, 60))
        && (!('tipoPromotor' in request.resource.data) || request.resource.data.tipoPromotor in ['proprio', 'compartilhado'])
        && (!('temFoto' in request.resource.data) || request.resource.data.temFoto is bool)
        && slugValido(request.resource.data.projeto)
        && texto(request.resource.data.projetoNome, 0, 140)
        && texto(request.resource.data.cliente, 0, 100)
        && texto(request.resource.data.nome, 2, 80)
        && texto(request.resource.data.telefone, 8, 20)
        && texto(request.resource.data.loja, 2, 140)
        // localização obrigatória (pedido de 15/09): registro sem ponto é recusado
        && request.resource.data.geo is map
        && geoValida(request.resource.data.geo)
        && texto(request.resource.data.geoStatus, 0, 20)
        && texto(request.resource.data.origem, 0, 10)
        && texto(request.resource.data.aparelho, 0, 200)
        // enxoval: peças executadas nesta instalação (páginas de uma peça só não mandam)
        && (!('pecas' in request.resource.data) || (request.resource.data.pecas is list && request.resource.data.pecas.size() <= 20
          && !temPecaDesligada(request.resource.data.projeto, request.resource.data.pecas)))
        && request.resource.data.criadoEm == request.time
        && paginaNoAr(request.resource.data.projeto)
        // página com acesso livre não manda senhaHash
        && (paginaSemSenha(request.resource.data.projeto)
          || senhaConfere(request.resource.data.projeto, request.resource.data.get('senhaHash', '')));

      // painel do cliente (link público): a equipe lê tudo; de fora, só os registros de um
      // projeto com link ativo, e a consulta precisa filtrar por projeto (a regra vale documento a documento)
      allow get, list: if equipe75() || projetoPublico(resource.data.projeto);
      allow update, delete: if equipe75();
    }

    // foto da fachada (16/09): um documento por instalação, com o mesmo id, criado logo depois do registro.
    // Só entra se a instalação existe, é recente e ainda não tem foto; ninguém de fora lê nem troca.
    match /fotos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['img', 'criadoEm'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 900000
        && request.resource.data.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.criadoEm == request.time
        && exists(/databases/$(database)/documents/instalacoes/$(id))
        && get(/databases/$(database)/documents/instalacoes/$(id)).data.criadoEm > request.time - duration.value(30, 'm');
      allow get: if equipe75()
        || (exists(/databases/$(database)/documents/instalacoes/$(id))
            && projetoComFotoPublica(get(/databases/$(database)/documents/instalacoes/$(id)).data.projeto));
      allow list, delete: if equipe75();
    }

    /* ---------------------------------------------------------------- link do cliente
       compartilhamentos/{token}: um link por campanha, criado no painel. Quem tem o token lê o
       documento (não dá para listar), e só enquanto estiver ativo e dentro da validade.
       publicos/{projeto}: espelho que o painel mantém, e é o que libera a leitura dos registros
       daquele projeto. Bloquear ou apagar o link no painel tira o projeto daqui e o link morre. */
    function compartilhamentoValido(d) {
      return d.keys().hasOnly(['titulo', 'cliente', 'projetos', 'ativo', 'fotos', 'promotores',
                               'observacao', 'expiraEm', 'criadoEm', 'criadoPor', 'atualizadoEm',
                               'atualizadoPor', 'visitas', 'ultimoAcesso'])
        && texto(d.titulo, 2, 120)
        && texto(d.cliente, 0, 120)
        && d.projetos is list && d.projetos.size() >= 1 && d.projetos.size() <= 12
        && d.ativo is bool && d.fotos is bool && d.promotores is bool
        && (!('observacao' in d) || texto(d.observacao, 0, 400))
        && (!('expiraEm' in d) || d.expiraEm == null || d.expiraEm is timestamp)
        && (!('visitas' in d) || d.visitas is number);
    }

    function linkNoAr(d) {
      return d.get('ativo', false) == true
        && (d.get('expiraEm', null) == null || d.expiraEm > request.time);
    }

    match /compartilhamentos/{token} {
      allow get: if equipe75() || linkNoAr(resource.data);
      allow list, delete: if equipe75();
      allow create, update: if equipe75() && compartilhamentoValido(request.resource.data);
      // o visitante só carimba a visita (nada mais pode mudar sem login)
      allow update: if linkNoAr(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitas', 'ultimoAcesso'])
        && request.resource.data.visitas == resource.data.get('visitas', 0) + 1
        && request.resource.data.ultimoAcesso == request.time;
    }

    match /publicos/{projeto} {
      allow get: if true;
      allow list: if equipe75();
      allow create, update: if equipe75() && slugValido(projeto)
        && request.resource.data.keys().hasOnly(['fotos', 'ate', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.fotos is bool
        && (request.resource.data.get('ate', null) == null || request.resource.data.ate is timestamp)
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == request.auth.token.email;
      allow delete: if equipe75();
    }

    /* ---------------------------------------------------------------- pulso das páginas
       acessos/{id}: um carimbo por etapa (abriu, senha, senha-ok, fora-do-ar, peças, registro,
       registrou), sem nada pessoal. É o que mostra quando alguém escaneia o QR e não termina
       o registro. Qualquer um cria (a página é pública), só a equipe lê e limpa. */
    match /acessos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['projeto', 'etapa', 'origem', 'sessao', 'so', 'criadoEm'])
        && slugValido(request.resource.data.projeto)
        && request.resource.data.etapa in ['abriu', 'senha', 'senha-ok', 'fora-do-ar', 'pecas', 'registro', 'registrou']
        && request.resource.data.origem in ['qr', 'link', 'equipe']
        && texto(request.resource.data.sessao, 1, 24)
        && request.resource.data.so in ['iOS', 'Android', 'outro']
        && request.resource.data.criadoEm == request.time;
      allow get, list, delete: if equipe75();
      allow update: if false;
    }

    match /{doc=**} {
      allow read, write: if false;
    }
  }
}
